    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@electron/osx-sign": "2.6.0",
    "@electron/packager": "20.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "electron": "44.3.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
