{
  "name": "zombie-fire-suppression-sim",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "mac": "./run-mac.command",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "dev": "vite --host 127.0.0.1",
